+@dataclass(frozen=True)
+class FrontEndConfig:
+    """Fixed frequency front end of the two recurrent models (RSNN and its RNN control), v1.3 / option B.
+
+    Each of the 22 EEG channels is split into the mu band (8-13 Hz) and the beta band (13-30 Hz), the two motor
+    rhythms that change during motor imagery. The recurrent models then get 22 x 2 = 44 inputs per time step (the 22 mu
+    channels first, then the 22 beta channels). The ANN and the converted SNN keep the 22-channel 4-40 Hz input.
+
+    The filters are FIXED: Butterworth band-passes applied forward and backward (zero phase) to the continuous 128 Hz
+    recording of each run, after the 4-40 Hz filter and the resampling, and before epoching, so the 0.5-2.5 s trial
+    window has no filter edge transients. Nothing is fitted to data and nothing is trained, so the front end adds no
+    parameters and cannot carry target or test information.
+    """
+
+    bands: tuple[tuple[float, float], ...] = ((8.0, 13.0), (13.0, 30.0))  # (low Hz, high Hz): mu, beta
+    filter_order: int = 4  # Butterworth order of one pass; forward-backward filtering doubles the effective order
+
+
+FRONT_END_CFG = FrontEndConfig()
+N_RECURRENT_INPUTS: int = N_CHANNELS * len(FRONT_END_CFG.bands)  # 44 inputs per step for the RSNN and the RNN
+
+
 @dataclass(frozen=True)
 class FoldConfig:
     n_repeats: int = 10
