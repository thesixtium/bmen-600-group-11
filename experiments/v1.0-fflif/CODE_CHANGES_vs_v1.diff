diff --git a/v1/code/src/models.py b/v1.0-fflif/code/src/models.py
index 427d568..a011e70 100644
--- a/v1/code/src/models.py
+++ b/v1.0-fflif/code/src/models.py
@@ -128,6 +128,58 @@ class RecurrentLIFNet(nn.Module):
         return self.readout(self.dropout(spike_count / n_steps))
 
 
+# ---------------------------------------------------------------- Recurrence-free control of the RSNN (FF-LIF)
+
+
+class FeedforwardLIFNet(RecurrentLIFNet):
+    """The RSNN with its recurrent weight matrix removed (FF-LIF): input projection -> ONE LIF layer with no
+    connections between hidden neurons -> linear readout.
+
+    Everything else is the RSNN's: the fixed input standardization, the LIF dynamics (beta, threshold, reset by
+    subtraction, fast-sigmoid surrogate), dropout, the readout on the time-averaged spike rate, and the training
+    (RSNN_CFG, RSNN_TRAIN, same folds and seeds). Dynamics for t = 1..T:
+      I_t = input_proj(x_t)                                  (the RSNN adds recurrent(s_{t-1}) here)
+      u_t = beta * u_{t-1} + I_t - threshold * s_{t-1}.detach()
+      s_t = Heaviside(u_t - threshold)
+    Each neuron keeps its own leaky membrane (memory of its own past input) and its own reset, but no neuron receives
+    another neuron's spikes, so there are no cycles between neurons. RSNN vs FF-LIF therefore isolates trained
+    inter-neuron recurrence. Removing the H x H matrix removes H^2 parameters, so the layer is widened to the
+    converted SNN's parameter budget (choose_fflif_hidden_size), the same budget the RSNN is matched to.
+    """
+
+    def __init__(self, n_inputs: int, n_hidden: int, n_classes: int, cfg: RSNNConfig = RSNNConfig()) -> None:
+        super().__init__(n_inputs, n_hidden, n_classes, cfg)
+        del self.recurrent  # no H x H weights: not in the module, the state_dict, the optimizer or the count
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        x = (x - self.ch_mean) / self.ch_std  # (B, C, T) standardized per input
+        x = x.permute(2, 0, 1)  # (T, B, C): one input sample per simulation step
+        n_steps = min(self.cfg.n_steps, x.shape[0])
+        batch = x.shape[1]
+        input_current = self.input_proj(x)  # (T, B, H): the whole input current, no recurrent term
+        mem = x.new_zeros(batch, self.n_hidden)
+        spk = x.new_zeros(batch, self.n_hidden)
+        spike_count = x.new_zeros(batch, self.n_hidden)
+        for t in range(n_steps):
+            mem = self.cfg.beta * mem + input_current[t] - self.cfg.threshold * spk.detach()
+            spk = self.spike_fn(mem - self.cfg.threshold)
+            spike_count = spike_count + spk
+        return self.readout(self.dropout(spike_count / n_steps))
+
+
+def fflif_param_count(n_inputs: int, n_hidden: int, n_classes: int) -> int:
+    """input_proj (W + b) + readout (W + b): the RSNN's count without the H x H recurrent matrix."""
+    return (n_inputs * n_hidden + n_hidden) + (n_hidden * n_classes + n_classes)
+
+
+def choose_fflif_hidden_size(target_params: int, n_inputs: int, n_classes: int, max_hidden: int = 2000) -> int:
+    """Largest hidden size whose FF-LIF parameter count does not exceed target_params (the converted SNN), the rule
+    the RSNN uses since v1.3, so FF-LIF never has more parameters than the converted SNN."""
+    fits = [h for h in range(1, max_hidden + 1) if fflif_param_count(n_inputs, h, n_classes) <= target_params]
+    assert fits, "no hidden size fits under the parameter budget"
+    return max(fits)
+
+
 # ---------------------------------------------------------------- Fully recurrent ELU network (non-spiking control)
 
 
