+# ---------------------------------------------------------------- Model 5: FF-LIF (recurrence-free control of the RSNN)
+
+
+def fflif_size() -> dict:
+    """Hidden size and parameter count of FF-LIF, widened to the converted SNN's budget (the RSNN's budget)."""
+    target = model_summary(EEGNET_CFG, RSNN_CFG)["converted_snn_params"]
+    hidden = choose_fflif_hidden_size(target, N_CHANNELS, N_CLASSES)
+    return {"fflif_hidden": hidden, "fflif_params": fflif_param_count(N_CHANNELS, hidden, N_CLASSES),
+            "converted_snn_params": target}
+
+
+def run_fflif_benchmark(processed: ProcessedData, folds: list[Fold], run_dir: Path, device: torch.device, timer: PipelineTimer) -> None:
+    """The RSNN without its recurrent matrix: same inputs, neuron settings, training schedule (RSNN_TRAIN) and folds."""
+    n_hidden = fflif_size()["fflif_hidden"]
+    tracker = timer.track("fflif", pending_folds(run_dir, "fflif", folds))
+    for fold in tracker.folds:
+        if timer.out_of_time("fflif"):
+            break
+        with tracker.fold(fold) as t:
+            data = build_fold_data(processed, fold)
+            torch.manual_seed(fold.seed)
+            model = FeedforwardLIFNet(N_CHANNELS, n_hidden, N_CLASSES, RSNN_CFG)
+            if RSNN_CFG.normalize_input:
+                # per-input standardization from the PRETRAINING data only (no target / test data), as the RSNN
+                model.set_input_stats(data.pre_train.X)
+            outcome = pretrain_then_finetune(model, data, RSNN_TRAIN, fold.seed, device, tag=f"[fflif {_stem(fold)}]")
+            t["pretrain_s"], t["finetune_s"] = outcome.pretrain_seconds, outcome.finetune_seconds
+            torch.save(
+                {"pretrained": outcome.pretrained_state, "finetuned": outcome.finetuned_state},
+                run_dir / "checkpoints" / "fflif" / f"{_stem(fold)}.pt",
+            )
+            _save_history(run_dir, "fflif", fold, outcome)
+            logits = predict_logits(model, data.test.X, device)
+            _save_result(
+                run_dir, "fflif", fold, data.test.y, logits.argmax(1), logits,
+                {"n_params": count_parameters(model), "n_hidden": n_hidden, **_best_epochs(outcome)},
+            )
+
+
 # ---------------------------------------------------------------- aggregation
 
 
