@@ -61,6 +61,21 @@ class EEGNet(nn.Module):
 # ---------------------------------------------------------------- Fully recurrent LIF network
 
 
+@torch.no_grad()
+def init_recurrent_weight(weight: torch.Tensor, gain: float, max_spectral_norm: float | None) -> None:
+    """W_rec ~ N(0, (gain / sqrt(H))^2), then (v1.4) scaled down so that its spectral norm is at most max_spectral_norm.
+
+    Shared by the RSNN and the RNN so both get identical initial recurrent weights for the same seed. The random draw is
+    the same as in v1 to v1.3 (same calls to the generator); only a positive scale factor <= 1 is applied afterwards.
+    """
+    n_hidden = weight.shape[0]
+    nn.init.normal_(weight, mean=0.0, std=gain / math.sqrt(n_hidden))
+    if max_spectral_norm is not None:
+        norm = torch.linalg.matrix_norm(weight, ord=2)  # largest singular value
+        if norm > max_spectral_norm:
+            weight.mul_(max_spectral_norm / norm)
+
