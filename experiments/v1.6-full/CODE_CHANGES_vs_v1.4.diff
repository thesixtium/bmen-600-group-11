index 7cc6b9d..a31af26 100644
--- a/v1.4/code/src/folds.py
+++ b/v1.6-full/code/src/folds.py
@@ -88,7 +88,37 @@ def _stack(processed: ProcessedData, subjects: list[int], session: str, field: s
     return Split(X=(X * INPUT_SCALE).astype(np.float32), y=y)
 
 
+def _subject_session(processed: ProcessedData, subject: int, session: str, field: str) -> Split:
+    """v1.6: one subject's session, scaled to microvolts, then z-scored per channel with this subject's OWN session-1
+    mean and SD (over trials and time; labels not used). Session 2 of a subject is scaled with its session-1 statistics,
+    so no session-2 information enters. Same computation as build_variant_data in local-train-v1.5-v1.7/screen_common.py."""
+    s1 = (getattr(processed[subject][TRAIN_SESSION], field) * INPUT_SCALE).astype(np.float32)
+    mean = s1.mean(axis=(0, 2), keepdims=True)
+    std = s1.std(axis=(0, 2), keepdims=True).clip(min=1e-6)
+    X = (getattr(processed[subject][session], field) * INPUT_SCALE).astype(np.float32)
+    return Split(X=((X - mean) / std).astype(np.float32), y=processed[subject][session].y)
+
+
+def _stack_normalized(processed: ProcessedData, subjects: list[int], session: str, field: str) -> Split:
+    parts = [_subject_session(processed, s, session, field) for s in subjects]
+    return Split(X=np.concatenate([p.X for p in parts]), y=np.concatenate([p.y for p in parts]))
+
+
 def build_fold_data(processed: ProcessedData, fold: Fold, field: str = "X") -> FoldData:
+    """v1.6: as v1.4, but every subject is z-scored per channel with its own session-1 statistics (see _subject_session).
+    Applies to both input kinds and to every split, including the target's session-2 test set."""
+    target_train = _subject_session(processed, fold.target, TRAIN_SESSION, field)
+    tr, va = np.array(fold.finetune_train_idx), np.array(fold.finetune_val_idx)
+    return FoldData(
+        pre_train=_stack_normalized(processed, list(fold.pretrain_subjects), TRAIN_SESSION, field),
+        pre_val=_stack_normalized(processed, list(fold.val_subjects), TRAIN_SESSION, field),
+        ft_train=Split(target_train.X[tr], target_train.y[tr]),
+        ft_val=Split(target_train.X[va], target_train.y[va]),
+        test=_subject_session(processed, fold.target, TEST_SESSION, field),
+    )
+
+
+def build_fold_data_v14(processed: ProcessedData, fold: Fold, field: str = "X") -> FoldData:
     """Trials of one fold. field = "X" (22-channel 4-40 Hz input: ANN, SNN) or "X_bands" (44 mu + beta band inputs:
     RSNN, RNN, v1.3). Both fields hold the same trials in the same order, so the split indices are identical."""
     target_train = _stack(processed, [fold.target], TRAIN_SESSION, field)
