+from benchmark_config import INPUT_SCALE, N_CLASSES, TEST_SESSION, TRAIN_SESSION, FoldConfig
 from preprocess_data import ProcessedData
 
 
@@ -89,6 +89,23 @@ def _stack(processed: ProcessedData, subjects: list[int], session: str, field: s
 
 
 def build_fold_data(processed: ProcessedData, fold: Fold, field: str = "X") -> FoldData:
+    """v1.7: as v1.4, but pretraining uses session 1 of ALL 8 non-target subjects, split 80 / 20 stratified by subject
+    and class (random_state = fold seed), instead of 5 training and 3 validation subjects. Fine-tuning and test splits
+    are unchanged. Same computation as build_variant_data in local-train-v1.5-v1.7/screen_common.py."""
+    base = build_fold_data_v14(processed, fold, field)
+    others = sorted(set(fold.pretrain_subjects) | set(fold.val_subjects))  # all 8 non-target subjects
+    assert fold.target not in others and len(others) == 8
+    pool = [_stack(processed, [s], TRAIN_SESSION, field) for s in others]
+    X = np.concatenate([p.X for p in pool])
+    y = np.concatenate([p.y for p in pool])
+    strata = np.concatenate([np.full(len(p.y), i) for i, p in enumerate(pool)]) * N_CLASSES + y
+    i_tr, i_va = train_test_split(np.arange(len(y)), test_size=0.2, stratify=strata, random_state=fold.seed)
+    i_tr, i_va = np.sort(i_tr), np.sort(i_va)
+    return FoldData(pre_train=Split(X[i_tr], y[i_tr]), pre_val=Split(X[i_va], y[i_va]),
+                    ft_train=base.ft_train, ft_val=base.ft_val, test=base.test)
+
+
+def build_fold_data_v14(processed: ProcessedData, fold: Fold, field: str = "X") -> FoldData:
     """Trials of one fold. field = "X" (22-channel 4-40 Hz input: ANN, SNN) or "X_bands" (44 mu + beta band inputs:
     RSNN, RNN, v1.3). Both fields hold the same trials in the same order, so the split indices are identical."""
     target_train = _stack(processed, [fold.target], TRAIN_SESSION, field)
